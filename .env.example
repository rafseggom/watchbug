# ======================================
# Configuración de Watchbug
# ======================================

# Control maestro - Activa/desactiva todo el sistema
WATCHBUG_ENABLED=True

# ======================================
# SENTRY - Tracking de errores
# ======================================
# Obtén tu DSN en: https://sentry.io/settings/projects/
# Formato: https://<key>@<org>.ingest.sentry.io/<project>
SENTRY_DSN=your_sentry_dsn_here

# ======================================
# LOGROCKET - Grabación de sesiones
# ======================================
# Obtén tu ID en: https://app.logrocket.com/ > Settings > Setup
# Formato: organization-slug/app-slug
LOGROCKET_ID=your_org/your_app

# Modo de grabación manual de LogRocket
# true = Usuario debe hacer clic en botón 📹 para iniciar grabación (recomendado para ahorrar sesiones)
# false = Grabación automática desde que carga la página (consume todas las sesiones)
LOGROCKET_MANUAL_RECORDING=true

# ======================================
# SUPABASE - Almacenamiento centralizado
# ======================================
# Obtén tus credenciales en: https://supabase.com/dashboard > Settings > API

# Project URL: https://<project-ref>.supabase.co
SUPABASE_URL=https://your_project.supabase.co

# Anon/Public Key (JWT que empieza con 'eyJ')
SUPABASE_KEY=your_supabase_anon_key_here

# Nombre del bucket de storage en Supabase (debe ser público)
# Crear bucket en: Supabase Dashboard > Storage > New Bucket
# Configurar como público para permitir acceso a screenshots
SUPABASE_BUCKET_NAME=watchbug-screenshots

# ======================================
# DASHBOARD DE ADMINISTRACIÓN
# ======================================
# IMPORTANTE: Solo activar en desarrollo, desactivar en producción
# Cuando está activo:
# - Aparece botón flotante 📊 al lado del botón de reportes 🐛
# - Dashboard accesible en /watchbug/dashboard
# - Muestra tabla de reportes, estadísticas y links a servicios
WATCHBUG_ADMIN=false
# Activar/desactivar Supabase (opcional, auto-detectado si hay URL y Key)
# SUPABASE_ENABLED=True

# ======================================
# VALIDACIÓN
# ======================================
# Para validar tu configuración:
#   1. Copia este archivo a .env
#   2. Rellena las credenciales de los servicios que quieras usar
#   3. Ejecuta: watchbug check
#   4. Para probar conectividad: watchbug check --online
#
# Ver estado actual: watchbug status
