# ======================================
# Configuración de Watchbug
# ======================================
# Sistema de reporte de bugs unificado que integra Sentry, LogRocket y Supabase

# --- CONTROL MAESTRO ---
# Activa o desactiva todo el sistema Watchbug
# Si es False, ningún servicio funcionará independientemente de su configuración
WATCHBUG_ENABLED=True

# ======================================
# SERVICIOS EXTERNOS
# ======================================
# Todos los servicios son opcionales y pueden usarse en cualquier combinación:
# - Solo Sentry/LogRocket: Los errores van directamente a esos servicios
# - Con Supabase: Almacenamiento centralizado de todos los reportes
# - Cualquier combinación funciona

# --- SENTRY ---
# Tracking de errores y stacktraces
# Obtén tu DSN en: https://sentry.io/settings/projects/
# Formato: https://<key>@<org>.ingest.sentry.io/<project>
SENTRY_DSN=your_sentry_dsn
# Activar/desactivar Sentry (opcional, auto-detectado si hay DSN)
# SENTRY_ENABLED=True

# --- LOGROCKET ---
# Grabación de sesiones de usuario para replay
# Obtén tu ID en: https://app.logrocket.com/ > Settings > Setup
# Formato: organization-slug/app-slug
LOGROCKET_ID=your_logrocket_project_id
# Activar/desactivar LogRocket (opcional, auto-detectado si hay ID)
# LOGROCKET_ENABLED=True

# --- SUPABASE ---
# Base de datos para almacenamiento centralizado de reportes
# Obtén tus credenciales en: https://supabase.com/dashboard > Settings > API
# Project URL: https://<project-ref>.supabase.co
SUPABASE_URL=your_supabase_url
# Anon/Public Key (JWT que empieza con 'eyJ')
SUPABASE_KEY=your_supabase_anon_key
# Activar/desactivar Supabase (opcional, auto-detectado si hay URL y Key)
# SUPABASE_ENABLED=True

# ======================================
# VALIDACIÓN
# ======================================
# Para validar tu configuración:
#   1. Copia este archivo a .env
#   2. Rellena las credenciales de los servicios que quieras usar
#   3. Ejecuta: watchbug check
#   4. Para probar conectividad: watchbug check --online
#
# Ver estado actual: watchbug status
